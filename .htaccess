<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request is not already pointing to dist/
  RewriteCond %{REQUEST_URI} !^/dist/

  # If the file exists in dist/, serve it from there
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -d
  RewriteRule ^(.*)$ /dist/$1 [L]

  # If no file found, serve dist/index.html (SPA fallback)
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(.*)$ /dist/index.html [L]
</IfModule>

# Correct MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
